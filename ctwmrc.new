#################################
#
# WINDOW-RING
#
##################################
# This variable specifies a list of windows 
# along which the f.warpring function cycles. 
# If no argument is given, all the windows are in the ring.

WindowRing {
#        "AppsClassName"
}
# f.wrapring warps only to windows visible in the current space
WarpRingOnScreen

# Don't raise windows when pointer is wraped to them
NoRaiseOnWarp

# Deiconify any iconified windows it encounters.
WarpUnmapped

#################################
#
# MOUSE BINDINGS
#
##################################
# X root
Button1 = : root : f.menu "NetBSD"
Button1 = m : root : f.menu "TwmAllWindows"
Button3 = : root : f.menu "wm-ops"

# Frames
Button1 = : frame : f.raise
Button3 = : frame : f.resize

# Windows
Button1 = m      : window : f.function "move-or-raise"
Button1 = s      : window : f.raiselower
Button1 = m4     : window : f.fullzoom
Button1 = m4 | m : window : f.fullscreenzoom
Button2 = m      : window : f.squeeze
Button2 = s      : window : f.identify
Button3 = m      : window : f.function "resize-or-lower"
Button3 = c      : window : f.iconify
Button3 = s      : window : f.occupy
Button3 = m4	 : window : f.occupyall

# Iconmgr
Button1 = : iconmgr : f.iconify
Button2 = : iconmgr : f.identify
Button3 = : iconmgr : f.menu "iconmgrmenu"

# Titlebar
Button1 =   : title : f.raiseorsqueeze
Button1 = m : title : f.menu "zoom"
Button3 =   : title : f.menu "windowmenu"
Button3 = m : title : f.raiselower

# Titlebar Buttons
LeftTitleButton ":menu"		= f.menu "windowmenu"
RightTitleButton ":dot"         = f.iconify
RightTitleButton "resize2"	= f.fullzoom
RightTitleButton ":delete"      = f.delete

##################################
#
# KEYBOARD BINDINGS
#
##################################
# Switch to workspace N
"1" = c : all : f.gotoworkspace "1"
"2" = c : all : f.gotoworkspace "2"
"3" = c : all : f.gotoworkspace "3"
"4" = c : all : f.gotoworkspace "4"

# Switch to adjacent workspace
"Right" = s : all : f.nextworkspace
"Left"  = s : all : f.prevworkspace

# Send window to workspace  N
"1" = c | s : all : f.function "move-to-workspace-1"
"2" = c | s : all : f.function "move-to-workspace-2"
"3" = c | s : all : f.function "move-to-workspace-3"
"4" = c | s : all : f.function "move-to-workspace-4"

# Send window to workspace  N & follow
"1" = mod1 | s | c : all : f.function "move-and-goto-workspace-1"
"2" = mod1 | s | c : all : f.function "move-and-goto-workspace-2"
"3" = mod1 | s | c : all : f.function "move-and-goto-workspace-3"
"4" = mod1 | s | c : all : f.function "move-and-goto-workspace-4"

# Occupy all workspaces
"a" = mod1 : all : f.occupyall

# Move windows 20 pixel with alt + vi-like binds or arrow keys.
"Up"    = mod1 : all : f.jumpup "20"
"Left"  = mod1 : all : f.jumpleft "20"
"Right" = mod1 : all : f.jumpright "20"
"Down"  = mod1 : all : f.jumpdown "20"

"k"	= mod1 : all : f.jumpup "20"
"j"	= mod1 : all : f.jumpleft "20"
"l"	= mod1 : all : f.jumpright "20"
"h"	= mod1 : all : f.jumpdown "20"

# Resize windows 10 pixel with alt + vi-like binds or arrow keys.
"Right" = mod1 | c : all : f.changesize "right +10"
"Left"  = mod1 | c : all : f.changesize "right -10"
"Down"  = mod1 | c : all : f.changesize "bottom +10"
"Up"    = mod1 | c : all : f.changesize "bottom -10"

"k"	= mod1 | c : all : f.changesize "right +10"
"j"	= mod1 | c : all : f.changesize "right -10"
"l"	= mod1 | c : all : f.changesize "bottom +10"
"h"	= mod1 | c : all : f.changesize "bottom -10"

# Maximize windows
"comma"	= mod1	   : all : f.zoom
"period"= mod1     : all : f.hzoom
"m"	= mod1     : all : f.fullzoom
"n"	= mod1	   : all : f.fullscreenzoom

# Tile windows
"Right" = m | m4 : all : f.rightzoom
"Left"  = m | m4 : all : f.leftzoom
"Down"  = m | m4 : all : f.bottomzoom
"Up"    = m | m4 : all : f.topzoom

# Rescue out-of-bound windows
"Backspace" = mod1  : all : f.rescuewindows

# Spawn a terminal
"Return" =  mod1 : all : f.exec "LC_ALL=en_US.UTF-8 urxvt &"

# File Manager
"f" = m4         : all : f.exec "thunar &"

# Browser 
"w" = m4         : all : f.exec "chromium &"
"q" = m4         : all : f.exec "firefox &"

# Restart the wm.
"r" = mod1       : all : f.restart

# Kill a window.                     
"x" = mod1       : all : f.delete 

# scripts path
define(`bindir',`/home/vins/bin')

# Center window
"g" = m4         : all : f.exec "bindir/center &"

# Launcher
"l" = m4         : all : f.exec "bindir/launch &"

# Show volume level
"v" = m4         : all : f.exec "bindir/vol &"

# Show battery level
"b" = m4         : all : f.exec "bindir/batt &"

# Save clipboard
"c" = m4         : all : f.exec "bindir/savexclip &"

# Now playing
"s" = m4         : all : f.exec "bindir/mpdnotify &"

# Dump root window
"Print" = m4     : all : f.exec "bindir/dumproot &"

# Alt(S)+Tab cyclewarp windows
"Tab"	= mod1	   : all : f.warpring "next"
"Tab"	= mod1 | s : all : f.warpring "prev"
"space"	= mod1	   : all : f.function "regain-focus"

# Volume keys
"XF86AudioLowerVolume" = : all : f.exec "mixerctl -w outputs.master2-=3,3 ; sh bindir/vol"
"XF86AudioRaiseVolume" = : all : f.exec "mixerctl -w outputs.master2+=3,3 ; sh bindir/vol"
"XF86AudioMute"        = : all : f.exec "mixerctl -w outputs.master2.mute=on ; sh bindir/vol"

# Multimedia Keys
"XF86AudioPlay" = : all : f.exec "mpc play  > /dev/null 2>&1 ; sh bindir/mpdnotify"
"XF86AudioStop" = : all : f.exec "mpc pause > /dev/null 2>&1 ; notify-send 'playback stopped'"
"XF86AudioPrev" = : all : f.exec "mpc prev  > /dev/null 2>&1 ; sh bindir/mpdnotify"
"XF86AudioNext" = : all : f.exec "mpc next  > /dev/null 2>&1 ; sh bindir/mpdnotify"

# WindowList
"o" = mod1         : all : f.menu "TwmAllWindows"
"p" = mod1         : all : f.menu "TwmWindows"

# IconMgr
"Left"  =        : iconmgr : f.backiconmgr
"Right" =        : iconmgr : f.forwiconmgr
"Up"    =        : iconmgr : f.upiconmgr
"Down"  =        : iconmgr : f.downiconmgr
"Up"    = s      : iconmgr : f.nexticonmgr
"Down"  = s      : iconmgr : f.previconmgr
"Tab"   =        : iconmgr : f.focus
"Tab"   = s      : iconmgr : f.raiselower
"Tab"   = mod5   : all     : f.nexticonmgr


##################################
#
# MENUS
#
##################################

syscmd(/usr/X11R7/libexec/ctwm_app_menu)
# Workspace submenu: Graphics
menu "gfx"
{
  "eyes"      f.exec "xeyes&"
  "star wars" f.exec "xterm -geometry 80x25 -fn -*-fixed-medium-*-*-*-24-*-*-*-*-*-*-1 -e telnet towel.blinkenlights.nl &"
  "BB"        f.exec "bb &"
  "clock"     f.exec "xclock &"
  "vidtun"    f.exec "xvidtune &"
  "matrix"    f.exec "xterm -e cmatrix &"
}

# Workspace submenu: Misc apps
menu "miscapps"
{
   "Firefox"     f.exec "firefox-esr &"
   "xbiff"	 f.exec "xbiff &"
   "console"     f.exec "xconsole &"
   "xedit"       f.exec "xedit &"
   "KeyboardSet" f.exec "xkbset-gui &"
   "xditview"    f.exec "xditview &"
   "Calculator"  f.exec "xcalc &"
   "xcutsel"     f.exec "xcutsel &"
   "Clipboard"   f.exec "xclipboard  &"
   "xsane"       f.exec "xsane &"
   "XMag"        f.exec "xmag -source 150x150 &"
   "XFontSel"    f.exec "xfontsel &"
   "Dillo"       f.exec "dillo &"
   "event Test"  f.exec "xev &"
   "XGC"         f.exec "xgc &"
}

# Workspace submenu: Audio apps
menu "audio"
{
   "VLC"          f.exec "vlc &"
}

menu "deskutils"
{
    "Desktop utilities"		f.title
    " Calculator"		!"xcalc &"
    " Text editor"		!"xedit &"
    ""				f.separator
    " XEyes"			!"xeyes &"
    " Spinning cube"		!"ico -sleep 0.016 -obj cube -colors darkorange &"
    ""				f.separator
    ""				f.separator
    " Magnify"			!"xmag -source 100x100 &"
    " Kill window"		!"xkill &"
}

menu "termutils"
{
    "Terminal utilities"	f.title
    ""				f.separator
    " VIsual Editor"		!"xterm -e vi &"
    ""				f.separator
    " Top processes"		!"xterm -e top &"
    "Battery"       f.exec   "xterm -e sudo tlp-stat -b &"
         
}

menu "NetBSD"
{
    "NetBSD"			f.title
    ""				f.separator
    " Pin menu"                 f.pin
    ""                          f.separator
    "Workspace"     f.title
    "XTerm"         f.exec "xterm -fn -misc-fixed-medium-r-*-*-18-*-*-*-*-*-iso10646-1 &"
    "Small XTerm"   f.exec "xterm &"
    "X-Large XTerm" f.exec "xterm -geometry 80x30 -fn -*-fixed-medium-*-*-*-24-*-*-*-*-*-*-1 &"
    ""              f.nop
    "Browser"       f.exec "dillo &"
    "Links2"        f.exec "links2 -g &"
    "File Manager"  f.exec "thunar &"
    ""              f.nop
    "Volume Mixer"  f.exec "xterm -e alsamixer --device pulse &"
    "Audio Panel"   f.exec "pavucontrol &"
    "HTop"          f.exec "xterm -e htop &"
    ""              f.nop
    "Graphics"      f.menu "gfx" 
    "Audio"         f.menu "audio"
    "Applications"  f.menu "miscapps"
    "All Apps'      f.exec "thunar /usr/share/applications/&"
    ""				f.separator
    " Desktop utilities"	f.menu "deskutils"
    " Terminal utilities"	f.menu "termutils"
    ""				f.separator
    " Refresh"			f.refresh
    " Restart CTWM"		f.twmrc
    " Quit"			f.quit
    "PowerOff"      f.exec  "sudo poweroff&"
}

menu "wm-ops" {
    "CTWM"			f.title
    ""				f.separator
    " Pin menu"			f.pin
    ""				f.separator
    " Version"			f.version
    " Sort icons"		f.sorticonmgr
    " Rescue windows"		f.rescuewindows
    " Hide icon mgr"		f.hideiconmgr
    " Show icon mgr"		f.showiconmgr
    " Hide pager"		f.hideworkspacemgr
    " Show pager"		f.showworkspacemgr
    " Prev Workspace"		f.prevworkspace
    " Next Workspace"		f.nextworkspace
}

menu "titleops"
{
